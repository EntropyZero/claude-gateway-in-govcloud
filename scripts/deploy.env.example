# Deployment configuration for the Claude apps gateway stacks.
#
#   cp scripts/deploy.env.example scripts/deploy.env   # deploy.env is gitignored
#   vi scripts/deploy.env
#
# Every deploy/operate script sources this file (the standalone egress-host
# mirror tools under scripts/mirror/ are the exception). Values marked
# (required) have no usable default and must be set before running the
# deploy scripts.

# --- AWS ---------------------------------------------------------------
export AWS_REGION="us-gov-west-1"
# export AWS_PROFILE="govcloud"          # uncomment if you use a named profile

# --- Naming ------------------------------------------------------------
# Must match between both stacks (02-gateway.yaml imports 01-database.yaml
# exports by this prefix).
export NAME_PREFIX="claude-gw"
export DB_STACK_NAME="${NAME_PREFIX}-db"
export GATEWAY_STACK_NAME="${NAME_PREFIX}"
export OBS_STACK_NAME="${NAME_PREFIX}-obs"
export PORTAL_STACK_NAME="${NAME_PREFIX}-portal"
# CloudFormation uploads templates here (templates > 51,200 bytes must deploy
# via S3). Leave empty to auto-create <prefix>-cfn-artifacts-<account>-<region>.
export DEPLOY_ARTIFACTS_BUCKET=""

# --- Network (required) ------------------------------------------------
# FIRST DECISION - does this VPC have NAT egress of its own?
#   NAT-equipped VPC:     the defaults below work as-is.
#   Landing-zone spoke (no NAT, TGW to central egress): a copy-paste deploy
#   FAILS at image pull unless you either set the three endpoint switches in
#   the "VPC endpoints" section below (recommended) or your TGW->central-NAT
#   path is allowlisted for ECR/S3 at the inspection firewall. See README
#   "ZPA & landing-zone prerequisites".
export VPC_ID=""                          # vpc-xxxxxxxx
export VPC_CIDR="10.20.0.0/16"            # used for listen.trusted_proxies
export PRIVATE_SUBNET_IDS=""              # comma-separated, >=2 AZs: subnet-aaa,subnet-bbb
# CIDR the ALB accepts 443 from. With ZPA this must cover the App
# CONNECTORS' source IPs (users arrive from connector IPs, not their own or
# CGNAT ranges) - and narrow it: 10.0.0.0/8 is an auditor finding, and
# on-prem connectors in 172.16/12 or 192.168/16 would be silently dropped.
export CLIENT_INGRESS_CIDR="10.0.0.0/8"   # NARROW THIS: ZPA App Connector subnets / VPN pool

# --- TLS / DNS (required) ----------------------------------------------
# ARN printed by scripts/import-enterprise-cert.sh import ...
export CERTIFICATE_ARN=""
# Corporate CNAME developers will use, e.g. claude-gateway.example.com
export GATEWAY_FQDN=""

# --- Container image ----------------------------------------------------
# Pinned Claude Code version baked into the gateway image (>= 2.1.195).
export CLAUDE_VERSION="2.1.207"
# Minimum Claude Code version clients must run, pushed to every client as
# requiredMinimumVersion via the managed settings: an older client exits at
# startup with instructions to update (enforcement starts at the client's
# next start after it has fetched /managed/settings). Empty -> defaults to
# CLAUDE_VERSION, so the floor follows every gateway upgrade; "none"
# disables the check; otherwise X.Y.Z.
export MIN_CLIENT_VERSION=""
# Organization-wide Claude rules pushed to every client via the managed
# settings (claudeMd): path to a markdown file whose content loads into
# every session's context BEFORE the user's ~/.claude/CLAUDE.md and any
# project CLAUDE.md; users cannot exclude it. Start from
# scripts/claude-rules.example.md and keep it SHORT: the JSON-encoded value
# must fit a 4096-char CloudFormation parameter (deploy-gateway.sh fails
# with the measured size if not), and every character costs context in
# every session for every user. The file must not contain a '${' sequence
# (the gateway expands ${NAME} in config values as env vars - deploy fails
# with guidance); bare $NAME is fine. Clients apply changes at their next
# settings fetch. Empty = no managed rules pushed.
export CLAUDE_MD_FILE=""
export ECR_REPO_NAME="claude-gateway"
# Leave IMAGE_URI empty to derive it from the current account + ECR_REPO_NAME.
export IMAGE_URI=""
# DB admin Lambda image (app-user bootstrap + secret rotation), built by
# scripts/build-and-push-dbadmin.sh (required for deploy-gateway.sh).
export DBADMIN_IMAGE=""
# App DB secret rotation cadence. Alternating users: the previous
# credential stays valid until the NEXT rotation.
export APP_SECRET_ROTATION_DAYS="90"

# --- Container BASE images ----------------------------------------------
# Digest-pinned ECR copies of the four base images, set for you by
# scripts/mirror/mirror-base-images.sh - leave them empty here. That script
# needs BOTH upstream-registry reach (Docker Hub + public.ecr.aws) AND AWS
# creds, like mirror/mirror-collector.sh; run it before the image builds.
# Empty = each build-and-push-*.sh falls back to its upstream default
# (public.ecr.aws / Docker Hub) - DEV CONVENIENCE ONLY: the offline build
# machine cannot reach those registries (.claude/rules/offline-build.md).
export GATEWAY_BASE_IMAGE=""   # consumed by build-and-push-image.sh
export LAMBDA_BASE_IMAGE=""    # consumed by build-and-push-dbadmin.sh
export GRAFANA_BASE_IMAGE=""   # consumed by build-and-push-grafana.sh
export PORTAL_BASE_IMAGE=""    # consumed by build-and-push-portal.sh

# --- Okta (required) ----------------------------------------------------
# MUST start with https:// (a scheme-less value crash-loops the gateway:
# "oidc.issuer must be an http(s) URL"). Custom auth server recommended, e.g.
# https://your-org.okta.com/oauth2/default; org server = https://your-org.okta.com
# (no trailing slash). For an Okta custom domain use it verbatim with https://,
# e.g. https://login.example.gov
export OKTA_ISSUER=""
# If VPC egress to Okta passes through TLS inspection (Zscaler etc.), the
# gateway/Grafana see the inspector's derived cert and token exchanges fail
# TLS. Preferred fix: an SSL-inspection exemption for the issuer FQDN on the
# server-side egress path (see docs/requests/networking-request-email.md). Interim /
# defense-in-depth: point this at the inspector's root CA PEM (a bundle is
# fine) - both image builds bake it into their trust stores. Rebuild the
# gateway and Grafana images after setting it.
export EXTRA_CA_CERT_PATH=""
# Trust anchor for scripts/set-spend-limit.sh's HTTPS calls to the gateway ALB
# (its cert is issued by your internal PKI, which the OS trust store lacks).
# Point it at the FULL issuing chain (issuing CA + root, PEM). The script ADDS
# this and EXTRA_CA_CERT_PATH to the system trust store (it never swaps the
# store out), so it verifies whichever chain the connection actually presents -
# internal PKI direct, or a TLS inspector's re-signed chain. NEVER use curl -k
# as a workaround - verification fails closed in this repo.
# ALSO baked into the portal image's trust store by build-and-push-portal.sh:
# the portal admin page calls the gateway server-side and needs the same
# anchor. Rebuild + push the portal image after changing it.
export GATEWAY_CA_BUNDLE=""
export OKTA_CLIENT_ID=""
# Comma-separated sign-in email domains, e.g. example.com,example.gov
export ALLOWED_EMAIL_DOMAINS=""
# --- Cost controls (per-user / per-group spend caps) -----------------------
# The gateway enforces spend caps per user, per Okta group, or org-wide. The
# stack configures the `admin:` block (the master switch - enforcement only
# runs when admin is configured) and mints read/write admin API keys into
# Secrets Manager. The CAPS THEMSELVES are data, not config: set them with
#   scripts/set-spend-limit.sh --scope user --id <sub> --amount 50
#   scripts/set-spend-limit.sh --scope rbac_group --id <group> --amount 2500
# No cap rows = no enforcement, so this is safe to deploy before setting any.
#
# NOTE: per-GROUP caps resolve against the Okta groups claim, so the gateway
# now requests the `groups` scope UNCONDITIONALLY. That claim is an org
# prerequisite (see docs/requests/okta-request-email.md). Per-USER caps key on `sub`
# and need no groups claim.
#
# How several matching group caps combine for one user: min = most restrictive
# wins (adding a group can only tighten); max = most permissive wins.
export SPEND_GROUP_LIMIT_MODE="min"
# Okta group(s) (comma-separated) whose members may administer spend caps AS
# THEMSELVES: the gateway accepts their session token (Bearer) as a write
# credential on the admin endpoints and audits the individual (oidc:<sub>)
# instead of a shared key id. The download portal's admin page (stack 04,
# PORTAL_ADMIN_GROUP) authenticates this way - set both to the same group.
# Empty (default) = bearer-token admin off; only the generated keys work.
export SPEND_ADMIN_GROUPS=""
# Org-specific text appended to the 429 a capped developer sees. No single quotes.
export SPEND_BLOCKED_MESSAGE="Contact the Claude Code platform team to request an increase."

# --- Models ---------------------------------------------------------------
# Developers get a three-model menu in Claude Code: Opus (the default),
# Sonnet, and the small/fast "haiku"-role model. The *_MODEL_ID is what they
# see - the gateway pushes these three IDs as the client's `availableModels`
# allowlist via /managed/settings, which is what actually constrains the
# /model picker; the *_BEDROCK_MODEL_ID is the GovCloud inference profile the
# gateway invokes. Defaults: Claude Opus 4.8 (default model), Claude Sonnet 5
# (Sonnet tier), and Claude Sonnet 4.5 in the haiku slot - GovCloud has no
# Haiku family, and HAIKU_MODEL_ID is also what the pushed
# ANTHROPIC_DEFAULT_HAIKU_MODEL points the client's background/small-model
# calls at. Note the ID formats: Opus 4.8 and Sonnet 5 use the un-dated
# format; Sonnet 4.5 keeps the dated -v1:0 format. The three *_MODEL_ID
# values must be distinct (deploy-gateway.sh refuses duplicates - upgrading
# from a pre-Sonnet-5 deploy.env means updating SONNET_MODEL_ID here).
# Confirm every profile ID BEFORE deploying:
#   aws bedrock list-inference-profiles --region us-gov-west-1
export OPUS_MODEL_ID="claude-opus-4-8"
export OPUS_BEDROCK_MODEL_ID="us-gov.anthropic.claude-opus-4-8"
export SONNET_MODEL_ID="claude-sonnet-5"
export SONNET_BEDROCK_MODEL_ID="us-gov.anthropic.claude-sonnet-5"
export HAIKU_MODEL_ID="claude-sonnet-4-5"
export HAIKU_BEDROCK_MODEL_ID="us-gov.anthropic.claude-sonnet-4-5-20250929-v1:0"

# --- Encryption ------------------------------------------------------------
# Customer-managed KMS key for everything at rest (RDS, secrets, CloudWatch
# logs, activity archive, AMP; ECR repos at creation). Leave empty and the
# database stack creates one (rotation enabled). Landing zones with central
# key management: pass the mandated key ARN - its policy must allow the
# CloudWatch Logs service principal (see the KmsKey resource in
# 01-database.yaml for the exact statement). The ALB access-logs bucket
# stays SSE-S3: ELB log delivery does not support KMS.
# The database stack persists the resolved key back here so the ECR repos
# created afterwards are CMK-encrypted (deploy 01 before the first image
# push - see README quick start). NOTE: the RDS storage key is a DAY-ONE
# decision - adopting/changing it on an existing deployment requires the
# teardown+restore migration in README "Teardown & update order".
# This variable feeds the SCRIPTS (ECR, mirroring, 02/03) - it does NOT
# decide the 01 stack's key ownership on re-runs: deploy-database.sh
# preserves the existing stack's own KmsKeyArn parameter (the persisted
# stack OUTPUT here must never flip a stack-created key into unmanaged
# bring-your-own mode). ALLOW_KMS_PARAM_CHANGE=1 is the deliberate override.
export KMS_KEY_ARN=""

# --- Database ------------------------------------------------------------
# RDS Postgres MINOR versions vary by region and are deprecated over time.
# Leave empty to use the template default, or pin a currently-available 16.x
# (must be 16.x - the parameter group family is postgres16). Find valid ones:
#   aws rds describe-db-engine-versions --engine postgres --region us-gov-west-1 \
#     --query "DBEngineVersions[?starts_with(EngineVersion,'16.')].EngineVersion" --output text
export DB_ENGINE_VERSION=""
# pgaudit classes exported to the postgresql CloudWatch log (AU-2/AU-3).
# Add 'read' to audit SELECTs at a real volume cost.
export PGAUDIT_LOG_CLASSES="ddl,role,write"

# --- Gateway service ----------------------------------------------------
export DESIRED_COUNT="2"
export SESSION_TTL_HOURS="1"
# Valid Fargate pairings only (the stack validates at deploy time):
# 512cpu/1-4GB, 1024/2-8GB, 2048/4-16GB, 4096/8-30GB, in 1024MB steps.
export TASK_CPU="1024"
export TASK_MEMORY="2048"
# ALB idle timeout: must exceed the longest silent gap in a streaming
# response (extended thinking can go minutes with no bytes on the wire).
export ALB_IDLE_TIMEOUT_SECONDS="900"
# Drain time on every rolling deploy. Streams still open when a deploy
# starts are cut after THIS long, and every deploy waits the full delay -
# 300 = +5 min per deploy. Raise toward the idle timeout only if cutting
# long turns during deploys is unacceptable.
export DEREGISTRATION_DELAY_SECONDS="300"
# Egress proxy for public endpoints (Okta OIDC). Set when the landing zone
# mandates a central proxy for internet egress; leave empty when egress is
# NAT-based (local, or a Transit Gateway egress VPC — TGW is transitive, so
# central NAT works). AWS APIs and the DB bypass the proxy via NO_PROXY,
# keeping Bedrock on the VPC endpoint either way.
# (Also injected into the Grafana task by deploy-observability.sh - its
# server-side Okta OAuth calls are public egress too.)
export HTTPS_PROXY_URL=""                  # e.g. http://proxy.corp.example.com:3128

# --- Observability (03-observability.yaml) --------------------------------
# Both image vars are set for you by their scripts (like the gateway images) -
# leave them empty here:
#   GRAFANA_IMAGE   <- scripts/build-and-push-grafana.sh
#   COLLECTOR_IMAGE <- scripts/mirror/mirror-collector.sh  (mirrors a pinned ADOT
#                      release into your ECR, CMK-encrypted + immutable, and
#                      persists the digest-pinned URI here). Pick the release
#                      with ADOT_VERSION=vX.Y.Z. Required for telemetry - there
#                      is no public default (a locked-down spoke can't reach
#                      public.ecr.aws, and an unpinned tag is a supply-chain
#                      risk). NOTE: the collector now runs as a loopback SIDECAR
#                      in the GATEWAY task, so this image is consumed by the
#                      gateway stack (02), not the observability stack (03).
# The Grafana ECR repo is tag-immutable; when you change docker/grafana/
# provisioning without bumping Grafana, rebuild with GRAFANA_IMAGE_TAG=<new>.
export GRAFANA_IMAGE=""
export COLLECTOR_IMAGE=""
export CREATE_AMP_ENDPOINT="false"         # aps-workspaces interface endpoint (no-NAT VPCs)
# AMP's KMS key is fixed at workspace creation: 'true' on an EXISTING
# deployment REPLACES the workspace and orphans all usage/cost history -
# existing deployments keep 'false' unless starting fresh is acceptable.
export ENCRYPT_AMP_WITH_CMK="true"
# Grafana auth = Okta SSO (per-user accounts; no shared admin password).
# Reuse the gateway's Okta app: add the redirect URI
# https://<GATEWAY_FQDN>/grafana/login/generic_oauth to it and set
# GRAFANA_OKTA_CLIENT_ID=$OKTA_CLIENT_ID (secret via
# scripts/set-grafana-oidc-secret.sh) - or register a dedicated app.
# OKTA_ISSUER above is reused for Grafana. Set OKTA_AUTH_SERVER_TYPE to
# match how it's built:
#   org    - the built-in org server; OKTA_ISSUER is the domain WITH scheme
#            (https://org.okta.com, no trailing slash). Grafana's endpoints
#            are derived under /oauth2/v1/..., and the org server's built-in
#            'groups' scope returns groups (request it - which Grafana does).
#   custom - a custom authorization server; OKTA_ISSUER ends in /oauth2/<id>
#            and you configure a groups scope + claim on it.
# Role mapping is strict: users in none of these groups cannot log in.
export OKTA_AUTH_SERVER_TYPE="org"
export GRAFANA_OKTA_CLIENT_ID=""
export GRAFANA_ADMIN_GROUP="grafana-admins"
export GRAFANA_EDITOR_GROUP=""
export GRAFANA_VIEWER_GROUP=""
export GRAFANA_DISABLE_LOGIN_FORM="true"   # false = temporary break-glass 'admin' form login
# Telemetry sidecar destinations. deploy-observability.sh AUTO-PERSISTS these
# from stack 03's outputs (WorkspacePrometheusEndpoint / WorkspaceArn /
# ActivityLogGroupName) - leave them empty here. Setting OBSERVABILITY_AMP_ENDPOINT
# turns the co-resident ADOT collector sidecar on in the gateway task on the
# next deploy-gateway.sh; the gateway then forwards all telemetry (its own +
# every client's, stamped with Okta user/groups) over localhost to the sidecar,
# which remote-writes to AMP. COLLECTOR_IMAGE (above) must be set when these are.
export OBSERVABILITY_AMP_ENDPOINT=""            # AMP Prometheus endpoint (ends with '/')
export OBSERVABILITY_AMP_WORKSPACE_ARN=""       # AMP workspace ARN (scopes the task role)
export OBSERVABILITY_ACTIVITY_LOG_GROUP=""      # activity-stream CloudWatch log group NAME
# Telemetry failure posture (AU-5). "true" (default): the sidecar is
# Essential and health-checked - if it fails, the task stops and is replaced
# rather than serving unmonitored traffic (fail closed). "false": gateway
# availability wins; a failed sidecar self-heals but never stops traffic
# (telemetry can silently gap). Policy decision - record it in the SSP.
export TELEMETRY_FAIL_CLOSED="true"
# End-to-end backstop for the posture above: alarm after this many
# consecutive minutes with NO samples ingested into the AMP workspace
# (stack 03; notifies ALARM_SNS_TOPIC_ARN when set). Container health only
# proves the collector is alive - this proves data is landing. 0 disables.
# It fires legitimately between the 03 deploy and the telemetry-enabled 02
# re-run, and during full gateway outages.
export MISSING_TELEMETRY_ALARM_MINUTES="15"
# Optional SEPARATE cessation alarm for the AI-activity AUDIT stream (only
# meaningful with FORWARD_ACTIVITY_LOGS=true below). 0 (default) = disabled.
# The audit stream is intermittent (events only when developers run tools),
# so a short window false-fires on idle nights/weekends - leave at 0 unless
# the fleet has continuous activity, then set this LONGER than the longest
# expected quiet gap. It cannot alone distinguish a broken pipeline from an
# idle fleet; the collector's exporter-error logs are the direct AU-5 signal.
export ACTIVITY_LOGS_ALARM_MINUTES="0"
# AI activity audit stream (bash commands, tool inputs, file paths per user;
# prompts stay redacted unless LOG_USER_PROMPTS below is also enabled).
# HIGHLY SENSITIVE — enable only where an audit
# trail is required. Flows into a short CloudWatch window then an S3
# archive; the pipeline exists either way and is free while idle.
export FORWARD_ACTIVITY_LOGS="false"
# CLIENT prompt-content capture: "true" pushes OTEL_LOG_USER_PROMPTS=1 to
# every client via the managed settings, so the claude_code.user_prompt
# telemetry event carries the FULL PROMPT TEXT (default is length only).
# The content rides the activity stream above — same CloudWatch window, S3
# archive, CMK, and IAM-only access; no new destination — so this REMOVES
# the "prompts stay redacted" property of that stream. Sensitivity then
# approaches BEDROCK_PROMPT_LOGGING below (this one is per-user-attributed;
# that one is verbatim both sides under the task-role identity). Assistant
# responses are governed by LOG_ASSISTANT_RESPONSES below — with it off,
# the push pins OTEL_LOG_ASSISTANT_RESPONSES=0, which would otherwise fall
# back to the prompts flag. Get organizational sign-off before enabling.
# Requires FORWARD_ACTIVITY_LOGS=true (deploy-gateway.sh refuses otherwise);
# clients pick it up at their next settings fetch, not instantly.
export LOG_USER_PROMPTS="false"
# Model RESPONSE capture, a separate opt-in independent of LOG_USER_PROMPTS
# (either, both, or neither): "true" pushes OTEL_LOG_ASSISTANT_RESPONSES=1
# so the claude_code.assistant_response event carries the model's response
# text into the same activity stream, with the same sensitivity caveats and
# sign-off expectation as prompts. Honored by clients >= 2.1.193 (older
# clients ignore it). Requires FORWARD_ACTIVITY_LOGS=true (same guard).
export LOG_ASSISTANT_RESPONSES="false"
export ACTIVITY_LOG_WINDOW_DAYS="14"       # CloudWatch operational window
export ACTIVITY_ARCHIVE_RETENTION_DAYS="731"  # S3 archive expiry
# Bedrock MODEL INVOCATION LOGGING (prompt logging): verbatim prompts AND
# model responses, logged by the Bedrock service itself. The destinations
# (CMK log group + CMK bucket + delivery role) are ALWAYS in stack 03,
# inert until enabled; this flag drives ONLY the account+region setting:
#   ""      never touch the account setting (default)
#   "true"  point Bedrock invocation logging at 03's destinations
#   "false" disable (account+region-wide); destinations and data remain
# READ BEFORE ENABLING:
#  - It is an ACCOUNT+REGION setting: it captures EVERY Bedrock call in the
#    account+region, not only this gateway's.
#  - The log identity for gateway traffic is the gateway TASK ROLE - it does
#    NOT attribute prompts to individual developers. Per-user auditing is the
#    activity stream (FORWARD_ACTIVITY_LOGS); this adds what-was-said.
#  - Sensitivity is strictly ABOVE the activity stream: CMK CloudWatch group
#    (window below) + CMK S3 bucket (full copy; also the only place bodies
#    >100 KB land). IAM-only; flag both for SIEM.
#  - Prerequisites: 01 re-run first (its CMK policy gains the Bedrock
#    delivery grant; BYO-key deployments add kms:GenerateDataKey for
#    bedrock.amazonaws.com themselves), and the operator running 03 needs
#    bedrock:*ModelInvocationLoggingConfiguration + iam:PassRole.
export BEDROCK_PROMPT_LOGGING=""
export BEDROCK_PROMPT_LOG_WINDOW_DAYS="14"      # CloudWatch operational window
export BEDROCK_PROMPT_ARCHIVE_RETENTION_DAYS="731"  # S3 expiry

# --- Download portal (04-download-portal.yaml) ----------------------------
# Optional stack: an Okta-secured internal website that hands developers a
# single, pre-configured Claude Code installer ZIP. Served on the SAME ALB /
# FQDN / cert / Zscaler entry as the gateway, path-based at /portal - no new
# org requests. Deploy after 02; independent of 03. The portal reaches the
# Okta issuer outbound over the SAME egress path (+ Zscaler SSL-inspection
# exemption) the gateway already needs - same prerequisite, not a new one.
#
# PORTAL_IMAGE is set for you by scripts/build-and-push-portal.sh - leave empty.
export PORTAL_IMAGE=""
export PORTAL_DESIRED_COUNT="2"
# Okta OIDC client for the portal. A DEDICATED Okta web app is recommended
# (clean rotation / least privilege, like Grafana); to reuse the gateway's app,
# add the redirect URI https://<GATEWAY_FQDN>/portal/oauth/callback to it and
# set PORTAL_OKTA_CLIENT_ID=$OKTA_CLIENT_ID (same secret via
# set-portal-oidc-secret.sh). OKTA_ISSUER above is reused; the portal discovers
# its endpoints from <issuer>/.well-known/openid-configuration (works for both
# the org and a custom authorization server). Scopes requested: openid profile
# email groups.
export PORTAL_OKTA_CLIENT_ID=""
# Okta group(s) allowed to download the installer (members allowed, everyone
# else denied + audited). One group, or several comma-separated - a member of
# ANY listed group is authorized. NEW parameterized group, named generically so
# the gateway can share it when group filtering is enabled there later.
#   single:    export ACCESS_GROUP="claude-gateway-users"
#   multiple:  export ACCESS_GROUP="claude-gateway-users,platform-eng,contractors"
export ACCESS_GROUP="claude-gateway-users"
# Okta group(s) (comma-separated) whose members get the portal's spend-cap
# admin page (/portal/admin). Set this to the SAME group(s) as
# SPEND_ADMIN_GROUPS above - the page acts with each admin's own gateway
# session token (gateway device flow), and the gateway re-checks membership
# against SPEND_ADMIN_GROUPS on every call; the portal stores no admin key.
# Empty (default) = no admin page.
export PORTAL_ADMIN_GROUP=""
# Okta group(s) (comma-separated) whose members see a Grafana dashboards link
# on the portal home page (-> https://<GATEWAY_FQDN>/grafana, where 03 serves
# Grafana). Set it to the union of the Grafana role groups above - e.g.
#   export PORTAL_GRAFANA_GROUPS="${GRAFANA_ADMIN_GROUP},${GRAFANA_EDITOR_GROUP},${GRAFANA_VIEWER_GROUP}"
# (dropping any that are empty) - those are the groups Grafana's strict role
# mapping actually lets in; the link is UX only, Grafana re-checks membership
# at login. Empty (default) = no link; leave empty when 03 is not deployed.
export PORTAL_GRAFANA_GROUPS=""
# Cost-center -> teams mapping for the portal's two-step dropdowns: the user
# picks a cost center first, then a team belonging to it. Comma-delimited
# entries of <cost-center>:<team>|<team>. PLACEHOLDER examples - set your real
# values. No spaces, commas, colons or pipes within a value (they become
# OTEL_RESOURCE_ATTRIBUTES labels); a malformed mapping fails the portal task
# at boot, and server-side validation rejects any team/cost-center pair not in
# the mapping (replaces the former flat PORTAL_TEAMS + PORTAL_COST_CENTERS
# lists). If the mapping churns often, consider moving it to SSM/S3 config (a
# stack update is otherwise needed to change it).
export PORTAL_COST_CENTER_TEAMS="CC-1000:platform|data,CC-2000:security"
# The pinned version the portal serves. Defaults to CLAUDE_VERSION. Publish it
# to the artifacts bucket with scripts/publish-portal-release.sh <version>.
export PORTAL_RELEASE_VERSION=""          # empty -> CLAUDE_VERSION
# S3 key (in the artifacts bucket) of the user-guide PDF served at
# /portal/guide. publish-portal-release.sh uploads docs/generated/user-manual.pdf
# to this key (SKIP_USER_GUIDE=1 skips). Override only to publish under a
# different key; the default matches the 04 template's UserGuideKey default.
# export PORTAL_USER_GUIDE_KEY="docs/user-manual.pdf"
# NOTE (portal v2): the portal's self-usage page (/portal/me) injects the
# gateway stack's READ-ONLY spend-admin key via a 02 cross-stack export -
# re-run scripts/deploy-gateway.sh (02) BEFORE deploying/updating 04, or the
# 04 deploy fails on the missing ${NAME_PREFIX}-spend-read-key-arn import.
# Bundle the enterprise/TLS-inspection CA (extra-ca.pem) into each ZIP and wire
# install.cmd's -ExtraCaCertPath to it. Set true only when you uploaded an
# extra-ca.pem via publish-portal-release.sh (EXTRA_CA_CERT_PATH set).
export PORTAL_BUNDLE_EXTRA_CA="false"
# Bake -DisableUpdates into the generated install.cmd (keeps laptops on the
# distributed version). Almost always true for a controlled rollout.
export PORTAL_DISABLE_UPDATES="true"
export PORTAL_SESSION_TTL_HOURS="8"        # portal session cookie lifetime
export PORTAL_AUDIT_RETENTION_DAYS="365"   # dedicated download-audit log group (flag for SIEM)
export PORTAL_LOG_RETENTION_DAYS="90"      # portal task operational (stdout) log group
# Priority of the /portal rule on the shared HTTPS listener. Must not collide
# with other listener rules (03-observability uses 10 for /grafana).
export PORTAL_LISTENER_RULE_PRIORITY="20"
# Set for you by deploy-download-portal.sh (the CMK-encrypted artifacts bucket
# publish-portal-release.sh uploads to) - leave empty.
export PORTAL_ARTIFACTS_BUCKET=""

# --- Monitoring -----------------------------------------------------------
# The stack always creates the ALB access-logs bucket and a CloudWatch alarm
# on the certificate's DaysToExpiry (imported ACM certs do not auto-renew).
export CERT_EXPIRY_ALARM_DAYS="30"
export ALARM_SNS_TOPIC_ARN=""              # optional: alarm notifications (02 cert-expiry +
                                           # db-rotation, 03 missing-telemetry)
export ALB_LOG_RETENTION_DAYS="90"
# deploy-gateway.sh deploys with --disable-rollback by default: a failed
# deploy KEEPS its healthy resources (CREATE_FAILED/UPDATE_FAILED) so you fix
# and re-run instead of waiting out a full rollback (~30 min of Lambda ENI
# teardown) and recreating. Set false for hands-off production updates where
# automatic rollback on failure is preferred.
export CFN_DISABLE_ROLLBACK="true"

# --- ALB log search (05-log-analytics.yaml) -------------------------------
# Optional stack: Athena workgroup + Glue table over the ALB access-logs
# bucket, so operators can search the logs with SQL (who hit what, when,
# from where - om-runbooks §14 has the runbook + example queries). Deploy
# any time after 02, independent of 03/04:
#   ./scripts/deploy-log-analytics.sh
# Serverless and idle-free: no standing cost, Athena bills per query on data
# scanned (the workgroup enforces a per-query cutoff as a guardrail).
# Stack name defaults to <NAME_PREFIX>-logs; override only on collision:
#export LOG_ANALYTICS_STACK_NAME=""
# First date the day-partition projection enumerates (yyyy/MM/dd, UTC).
# Earlier than the first delivered log object is harmless (empty partitions
# scan nothing); later HIDES older logs from every query. No need to tune -
# the bucket expires objects per ALB_LOG_RETENTION_DAYS regardless.
export ALB_LOGS_PROJECTION_START="2025/01/01"
# Query results are CSV log excerpts in a CMK bucket; expire them after:
export ATHENA_RESULTS_RETENTION_DAYS="30"
# Per-query data-scanned cutoff in bytes (default 10 GiB; Athena's floor
# for the setting is 10000000, i.e. 10 MB).
export ATHENA_SCAN_CUTOFF_BYTES="10737418240"
# Set for you by deploy-log-analytics.sh (consumed by
# scripts/diagnostics/athena-alb-query.sh) - leave empty.
export ATHENA_WORKGROUP=""
export ATHENA_DATABASE=""
export ATHENA_TABLE=""
export ATHENA_RESULTS_BUCKET=""

# --- VPC endpoints --------------------------------------------------------
# Landing-zone spoke with no NAT? You almost certainly want all three:
#   CREATE_SUPPORTING_ENDPOINTS="true"  PRIVATE_ROUTE_TABLE_IDS="rtb-..."
#   CREATE_BEDROCK_ENDPOINT="true"
# ...UNLESS shared services centralize interface endpoints (PHZs associated
# to this VPC) - then creating local private-DNS endpoints FAILS the stack:
# keep CREATE_SUPPORTING_ENDPOINTS=false, and for a centralized
# bedrock-runtime endpoint set BEDROCK_PRIVATE_DNS=false (and apply the
# Claude-only endpoint policy centrally). The S3 GATEWAY endpoint cannot be
# centralized over TGW - create it locally in every case.
# bedrock-runtime endpoint: keeps inference off any NAT/IGW path.
export CREATE_BEDROCK_ENDPOINT="true"
export BEDROCK_PRIVATE_DNS="true"          # false when a centralized bedrock endpoint's PHZ covers this VPC
# Set true for fully-private subnets with no NAT: adds ecr.api, ecr.dkr,
# logs, secretsmanager, ecs interface endpoints (Fargate's own dependencies,
# billed per AZ-hour). With NAT, leave false.
# Either way the gateway needs an egress path to the Okta issuer for OIDC.
# Consumed by BOTH 02 and 03: when true, 03 adds its collector/Grafana SGs as
# ingress on 02's shared endpoint SG (their private DNS forces those tasks
# onto the endpoints), so keep this identical across the two deploys.
export CREATE_SUPPORTING_ENDPOINTS="false"
# Running these scripts from an EC2 instance INSIDE the VPC? Set its security
# group here. The endpoints' private DNS captures the instance's aws/docker
# API calls too, and the endpoint SG otherwise drops them (calls to
# ecr/logs/secretsmanager/ecs time out from the admin host). Consumed by BOTH
# 02 (shared endpoint SG) and 03 (the aps-workspaces endpoint SG, so
# diagnose-telemetry.sh can query AMP from an in-VPC host when CreateAmpEndpoint
# is true).
export ADMIN_CLIENT_SG_ID=""
# SKIP any supporting endpoint the landing zone already CENTRALIZES (a shared
# endpoint whose private hosted zone is associated with this VPC) - a local
# private-DNS endpoint for the same service otherwise fails with a
# "conflicting DNS name" error. Find which services are centralized:
#   aws route53 list-hosted-zones-by-vpc --vpc-id "$VPC_ID" \
#     --vpc-region "$AWS_REGION" --query 'HostedZoneSummaries[].Name' --output text
# Set the matching one(s) to false (only applies when SUPPORTING_ENDPOINTS=true):
export CREATE_ECR_API_ENDPOINT="true"
export CREATE_ECR_DKR_ENDPOINT="true"
export CREATE_LOGS_ENDPOINT="true"
export CREATE_SECRETSMANAGER_ENDPOINT="true"
export CREATE_ECS_ENDPOINT="true"
# Private route table IDs (rtb-aaa,rtb-bbb): when set, creates a FREE S3
# gateway endpoint — recommended in every VPC (keeps ECR image-layer pulls
# off NAT data-processing charges) and required for pulls without NAT.
export PRIVATE_ROUTE_TABLE_IDS=""
